# Copy this file to `.env` and paste in your own keys.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real keys.
# Every key below is optional except SCRAPERTECH_KEY and LOCALPIPE_KEY --
# the pipeline degrades gracefully if a waterfall key is missing.

# --- Stage 1: Google Maps scrape ---
# https://scraper.tech  ->  Panel  ->  Google Maps API  ->  API Key
# Billing is per REQUEST, not per result (one request can return 200+ businesses).
SCRAPERTECH_KEY=your_scrapertech_key_here

# --- Stage 3: owner name + email ---
# https://localpipe.io  ->  dashboard  ->  API key (starts with lp_)
# Credits are charged only when data is found.
LOCALPIPE_KEY=lp_your_localpipe_key_here

# --- Stage 4a: waterfall fallback ---
# https://ai-ark.com  ->  developer portal
AIARK_KEY=your_aiark_key_here

# --- Stage 4b: waterfall fallback ---
# https://prospeo.io  ->  https://app.prospeo.io/api  (starts with pk_)
# 1 credit per successful enrichment, free on no-match.
PROSPEO_KEY=pk_your_prospeo_key_here
